# 运行环境：development / production
ENV=development

# 数据库连接串（默认 MySQL；如需 SQLite 可改为 sqlite:///./teachhub.db）
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/teachhub?charset=utf8mb4

# JWT 签名密钥（生产环境必须改为强随机值，否则启动失败）
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 文件上传上限（字节，默认 20MB）
MAX_UPLOAD_SIZE=20971520
